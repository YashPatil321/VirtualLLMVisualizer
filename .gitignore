*.pdb
*.mdb
*.opendb
*.VC.db

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# OS noise
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
crashlytics-build.properties
