# Unity generated. Never commit these; see CLAUDE.md.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore .meta files. A script or asset committed without its .meta
# breaks every reference for whoever clones next.
!/**/*.meta

# Generated IDE and solution files
.vs/
.idea/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Per-machine Claude Code settings. Shared ones go in .claude/settings.json.
.claude/settings.local.json

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# OS noise
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
crashlytics-build.properties
