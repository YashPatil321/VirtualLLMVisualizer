%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 19087cf1b75144e18b7c2499c1dedeaa, type: 3}
  m_Name: AssemblySequence
  m_EditorClassIdentifier: 
  steps:
  - stepId: frame
    partName: "Open air frame"
    kind: 0
    cardIndex: -1
    travelSeconds: 2.5
    settleSeconds: 0.6
    narration: "An open frame. Eight cards need airflow more than they need a case."
    labelled: 1
    label: "Open-air frame"
    detail: "Two levels: cards on top, board and power below"
    labelOffset: {x: -0.42, y: 0.18, z: -0.22}
    labelSeconds: 7
  - stepId: motherboard
    partName: "Motherboard"
    kind: 1
    cardIndex: -1
    travelSeconds: 2.0
    settleSeconds: 0.5
    narration: "The motherboard. Its job here is mostly to have enough PCIe lanes."
    labelled: 1
    label: "ASUS B250 mining board"
    detail: "Made for mining rigs: 19 PCIe slots"
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 7
  - stepId: cpu
    partName: "CPU"
    kind: 2
    cardIndex: -1
    travelSeconds: 1.5
    settleSeconds: 0.4
    narration: "The CPU barely works during inference. The cards do that."
    labelled: 1
    label: "CPU and cooler"
    detail: "Hands work to the cards, then mostly waits"
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 7
  - stepId: ram
    partName: "System RAM"
    kind: 3
    cardIndex: -1
    travelSeconds: 1.5
    settleSeconds: 0.4
    narration: "System memory holds the model while it is on its way to the cards."
    labelled: 1
    label: "System RAM"
    detail: "Models pass through here on their way to VRAM"
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 7
  - stepId: psu
    partName: "Power supply 1"
    kind: 4
    cardIndex: -1
    travelSeconds: 2.2
    settleSeconds: 0.6
    narration: "Eight cards is a lot of power. This is the part people underestimate."
    labelled: 1
    label: "Antec HCP 1300 W"
    detail: "80 PLUS Platinum: little power lost as heat"
    labelOffset: {x: -0.3, y: 0.06, z: 0}
    labelSeconds: 7
  - stepId: psu-2
    partName: "Power supply 2"
    kind: 4
    cardIndex: -1
    travelSeconds: 2.2
    settleSeconds: 0.6
    narration: "So Rig 2 has two of them, thirteen hundred watts each."
    labelled: 1
    label: "Antec HCP 1300 W"
    detail: "Two supplies: 2,600 W between them"
    labelOffset: {x: 0.3, y: 0.06, z: 0}
    labelSeconds: 7
  - stepId: riser-0
    partName: "Riser 0"
    kind: 5
    cardIndex: 0
    travelSeconds: 1.0
    settleSeconds: 0.3
    narration: "A riser lifts the card off the board so eight of them fit."
    labelled: 1
    label: "PCIe risers (8)"
    detail: "The blue cable isn't USB: it carries one PCIe lane"
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 7
  - stepId: riser-1
    partName: "Riser 1"
    kind: 5
    cardIndex: 1
    travelSeconds: 1.0
    settleSeconds: 0.3
