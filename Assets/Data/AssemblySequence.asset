  - stepId: gpu-0
    partName: "GTX 1070, card 0"
    kind: 6
    cardIndex: 0
    travelSeconds: 1.6
    settleSeconds: 0.5
    narration: "First card in. Eight gigabytes of VRAM, and seven more to go."
    labelled: 1
    label: "GPU 0  ·  GTX 1070"
    detail: "8 GB GDDR5  ·  1,920 CUDA cores  ·  150 W"
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 7
  - stepId: gpu-1
    partName: "GTX 1070, card 1"
    kind: 6
