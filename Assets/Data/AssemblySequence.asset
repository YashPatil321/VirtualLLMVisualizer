    labelled: 1
    label: "GPU 6"
    detail: ""
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 5
  - stepId: gpu-7
    partName: "GTX 1070, card 7"
    kind: 6
    cardIndex: 7
    travelSeconds: 1.6
    settleSeconds: 0.5
    narration: "That is all eight. Sixty-four gigabytes of VRAM between them."
    labelled: 1
    label: "GPU 7"
    detail: "Eight cards: 64 GB of VRAM, 15,360 CUDA cores"
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 7
  - stepId: pcie-power
    partName: "PCIe power"
    kind: 7
    cardIndex: -1
    travelSeconds: 2.0
    settleSeconds: 0.5
    narration: "Every card gets its own power. Eight cards is a power problem first."
    labelled: 1
    label: "PCIe power cables"
    detail: "Each card can draw up to 150 W"
    labelOffset: {x: 0, y: 0, z: 0}
    labelSeconds: 7
  gapSeconds: 0.25
