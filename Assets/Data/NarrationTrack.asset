%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ddcf5ec6f26946248ce11706e5ff255a, type: 3}
  m_Name: NarrationTrack
  m_EditorClassIdentifier: 
  lines:
  - cue: act.EmptyBench
    text: "A bare frame and a tray of parts. Nothing is running yet."
    holdSeconds: 6
    clip: {fileID: 0}
  - cue: act.Assembly
    text: "This is how one of our rigs goes together."
    holdSeconds: 5
    clip: {fileID: 0}
  - cue: act.PowerOn
    text: "Power on. Eight cards, one machine."
    holdSeconds: 5
    clip: {fileID: 0}
  - cue: act.Request
    text: "A student just asked our model a question. Watch where it goes."
    holdSeconds: 5
    clip: {fileID: 0}
  - cue: act.Answer
    text: "The answer streamed back the same way it came, token by token."
    holdSeconds: 6
    clip: {fileID: 0}
  - cue: act.Complete
    text: "That was Rig 2, our dev and test rig. Rig 1 serves students the same way."
    holdSeconds: 6
    clip: {fileID: 0}
  - cue: hop.Client
    text: "It leaves the student's browser over HTTPS."
    holdSeconds: 2
    clip: {fileID: 0}
  - cue: hop.Broker
    text: "The broker signs the student in and puts the job in a queue."
    holdSeconds: 3
    clip: {fileID: 0}
  - cue: hop.Scheduler
    text: "Scheduling: a healthy replica with the model already loaded, and the least busy one."
    holdSeconds: 3
    clip: {fileID: 0}
  - cue: hop.Rig
    text: "llama-server on Rig 2 takes the job."
    holdSeconds: 2
    clip: {fileID: 0}
  - cue: hop.Model
    text: "Four cards, one model. Qwen 27B is split across them, layer by layer."
    holdSeconds: 5
    clip: {fileID: 0}
  - cue: hop.Relay
    text: "First stop, our AWS relay. NGINX ends the encryption and rate limits it."
    holdSeconds: 4
    clip: {fileID: 0}
  - cue: hop.Store
    text: "Redis knows which workers are healthy, and which have the model loaded."
    holdSeconds: 4
    clip: {fileID: 0}
  - cue: hop.Network
    text: "NetBird carries it privately to the rig. Students never touch a rig directly."
    holdSeconds: 4
    clip: {fileID: 0}
  defaultHoldSeconds: 4
